# Dependencies
node_modules/
venv/
.venv/
env/
__pycache__/
*.pyc

# Build artifacts
dist/
build/
*.egg-info/

# Environment variables and secrets (docs/28_Security_and_Privacy.md)
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# IDE
.vscode/*
!.vscode/settings.json
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Data (sensitive/large files) -- synthetic data generated for the project
# still ships as .csv under data/, so it is tracked deliberately per file
# rather than through a blanket *.csv ignore rule.
!data/**/.gitkeep

# Runtime upload storage (docs/13_Image_Preprocessing.md S23) -- holds
# copies of whatever is uploaded at runtime and must never be committed,
# even though in this project it only ever contains synthetic test data.
data/runtime/

# Handwritten cheque samples may contain personal financial information.
data/IDRBT/

# Models (large binary files)
*.pkl
*.h5
*.pt
*.onnx
!models/**/.gitkeep

# Testing
.pytest_cache/
.coverage
coverage/
